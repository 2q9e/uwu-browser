<translation id="3079753320517721795">{NUM_DEVICES,plural, =0{Kiendelezi kimoja au zaidi cha uwu chromium kilikuwa kinafikia kifaa 1 cha USB}=1{Kiendelezi kimoja au zaidi cha uwu chromium kinafikia kifaa 1 cha USB}other{Kiendelezi kimoja au zaidi cha uwu chromium kinafikia vifaa # vya USB}}</translation>
<translation id="3095811995836568724">Historia kwenye uwu chromium</translation>
<translation id="3103660991484857065">Kisakinishi kilishindwa kufinyuza kumbukumbu. Tafadhali pakua uwu chromium tena.</translation>
<translation id="310459126943037700">Imeshindwa kukamilisha majukumu.</translation>
<translation id="3104828284009500087">Tafuta chochote kwenye ukurasa</translation>
<translation id="3126784891977756556">Hakikisha manenosiri, alamisho na historia yako imesawazishwa kikamilifu kwenye vifaa mbalimbali. Fikia kwa urahisi vipengele unavyovifahamu na kuvipenda kwa kusasisha kivinjari chako chaguomsingi kiwe uwu chromium.</translation>
<translation id="3130323860337406239">uwu chromium inatumia maikrofoni yako.</translation>
<translation id="3130333203120345554">Utafutaji mpya</translation>
<translation id="3137969841538672700">Buruta ili utafute</translation>
<translation id="3144188012276422546">Kichupo hiki kinatumia nyenzo za ziada. Ruhusu uwu chromium ikifanye kisitumike ili kuboresha utendaji wako.</translation>
<translation id="3149163023759831301">Ili uonyeshe skrini yako, washa kinasa skrini katika uwu chromium kwenye Mipangilio ya Mfumo</translation>
<translation id="3155163173539279776">Zindua upya uwu chromium</translation>
<translation id="3161522574479303604">Lugha zote</translation>
<translation id="3179665906251668410">Fungua Kiungo katika Dirisha Fiche la uwu chromium</translation>
<translation id="3185330573522821672">Weka wasifu wako mpya wa uwu chromium uwe upendavyo</translation>
<translation id="3189205223539394158">Unaweza kuendelea kupiga gumzo na Modi ya AI bila kubadilisha vichupo. Ili uanze, ingia katika akaunti ya uwu chromium. Pia utapata manenosiri yako na zaidi kwenye vifaa vyako vyote.</translation>
<translation id="3224847870593914902">Ili uondoe Akaunti yako ya Google kwenye uwu chromium, ondoka kwenye uwu chromium katika ukurasa wa Mipangilio</translation>
<translation id="3234316605225071811">Baadaye, uwu chromium inaweza kukuuliza ikiwa ungependa kutumia taarifa ulizohifadhi ili ijaze fomu kiotomatiki kwa niaba yako</translation>
<translation id="3258596308407688501">uwu chromium haiwezi kusoma na kuandika kwenye saraka yake ya data:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">Pata zana upendazo za akiliunde kutoka Google popote ulipo ukitumia uwu chromium kwenye iOS.</translation>
<translation id="3286538390144397061">Zima na uwashe sasa</translation>
<translation id="328888136576916638">Funguo za Google API zinakosekana. Utendaji fulani wa uwu chromium utazimwa.</translation>
<translation id="3296368748942286671">Endelea kuendesha programu za mandharinyuma wakati uwu chromium imefungwa</translation>
<translation id="3313189106987092621">uwu chromium itakutahadharisha kabla ya kupakia tovuti yoyote kwa kutumia muunganisho usio salama</translation>
<translation id="3316771292331273802">Utaondolewa kwenye tovuti nyingi ukifunga madirisha yote ya uwu chromium, isipokuwa katika Akaunti yako ya Google ikiwa umeingia katika uwu chromium. Ili uruhusu tovuti zikukumbuke, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">kona ya juu kulia ya eneo la utafutaji: kulia asilimia <ph name="RIGHT" />, juu asilimia <ph name="TOP" /></translation>
