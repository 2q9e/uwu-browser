<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="130631256467250065">تغییرات بار بعد که دستگاه راه‌اندازی می‌شود اعمال می‌شوند.</translation>
<translation id="1965068424387304464">‏نکته Uwu Browser: گذرواژه‌ها را ذخیره کنید</translation>
<translation id="261308610302996111">‏به
          «منو Uwu Browser &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />»
          بروید و مطمئن شوید پیکربندی روی «no proxy» (بدون پراکسی) یا «direct» (مستقیم) تنظیم شده باشد.</translation>
<translation id="275588974610408078">‏گزارش خرابی در Uwu Browser موجود نیست.</translation>
<translation id="3064346599913645280">‏درحال مشاهده یک صفحه Uwu Browser امن هستید</translation>
<translation id="3255926992597692024">‏Chromebook می‌خواهد تنظیمات تکمیل روش‌های پرداخت را اصلاح کند.</translation>
<translation id="358997566136285270">‏نشان‌واره Uwu Browser</translation>
<translation id="3837584850181228767">‏نکته Uwu Browser: «مرور ایمن پیشرفته»</translation>
<translation id="4050599136622776556">‏Uwu Browser می‌خواهد روش‌های پرداخت را ویرایش کند.</translation>
<translation id="4365115785552740256">‏Uwu Browser با پروژه منبع باز <ph name="BEGIN_LINK_CHROMIUM" />Uwu Browser <ph name="END_LINK_CHROMIUM" /> و سایر <ph name="BEGIN_LINK_OSS" />نرم‌افزار منبع باز<ph name="END_LINK_OSS" /> امکان‌پذیر است.</translation>
<translation id="4622039161600275920">‏این صفحه را Uwu Browser مسدود کرده است</translation>
<translation id="48558539577516920">‏در تنظیمات دیوار آتش و ضدویروستان، به Uwu Browser اجازه دسترسی به شبکه را
          بدهید.</translation>
<translation id="4949828774841497663">به «برنامه‌ها &gt; تنظیمات سیستم &gt; شبکه» بروید، شبکه
          فعال را انتخاب کنید، روی دکمه «جزئیات…» کلیک کنید، و همه
          پراکسی‌هایی را که ممکن است انتخاب شده باشند لغو انتخاب کنید.</translation>
<translation id="6480456350195404966">‏به
          «منو Uwu Browser &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          شبکه و اینترنت &gt; پراکسی»
          بروید و «Automatically detect settings» (تشخیص خودکار تنظیمات) را لغو انتخاب کنید.</translation>
<translation id="648062525172759633">‏این صفحه‌ها برای استفاده توسعه‌دهندگان Uwu Browser درنظر گرفته شده‌اند و ممکن است به‌طور فعال نگهداری یا آزمایش نشوند. برای فعال کردن آن‌ها، به <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> بروید، روی دکمه فعال کردن صفحه‌های اشکال‌زدایی کلیک کنید و سپس دوباره به این صفحه بروید.</translation>
<translation id="6549378540556750549">‏ارائه Chromium ازطریق <ph name="BEGIN_LINK_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_OSS" /> دیگر نیز ممکن شده است.</translation>
<translation id="6613594504749178791">‏دفعه بعدی که Uwu Browser را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="691026815377248078">‏Uwu Browser باید برای ادامه مرتبط‌سازی به بلوتوث
دسترسی داشته باشد. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">‏ارائه Chromium ازطریق پروژه متن‌باز <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ممکن شده است.</translation>
<translation id="7861509383340276692">‏به
          منوی Uwu Browser &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          بروید و علامت «<ph name="NO_PREFETCH_DESCRIPTION" />» را بردارید.
          درصورتی‌که با این کار مشکل حل نشد، توصیه می‌کنیم برای عملکرد بهبودیافته،
          این گزینه را دوباره انتخاب کنید.</translation>
<translation id="8597726643333341451">‏درحال مشاهده یکی از صفحه‌های امن Chrome for Testing هستید</translation>
<translation id="8684913864886094367">‏Uwu Browser به درستی خاموش نشده است.</translation>
<translation id="9183331186620388872">‏نکته Uwu Browser: جستجو کردن با «لنز»</translation>
</translationbundle>