<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="130631256467250065">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ອຸປະກອນຂອງທ່ານໃໝ່.</translation>
<translation id="1965068424387304464">ເຄັດລັບ uwu chromium: ບັນທຶກລະຫັດຜ່ານ</translation>
<translation id="261308610302996111">ເຂົ້າໄປ
          ເມນູ uwu chromium &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          ແລະ ກວດສອບວ່າມີການກຳນົດການຕັ້ງຄ່າຂອງທ່ານເປັນ "ບໍ່ມີພຣັອກຊີ" ຫຼື "ໂດຍກົງ".</translation>
<translation id="275588974610408078">ບໍ່ມີການລາຍງານການຂັດຂ້ອງຢູ່ໃນ uwu chromium​.</translation>
<translation id="3064346599913645280">ທ່ານກຳລັງເບິ່ງໜ້າ uwu chromium ທີ່ປອດໄພ</translation>
<translation id="3255926992597692024">uwu chromium ກຳລັງພະຍາຍາມແກ້ໄຂການຕັ້ງຄ່າສຳລັບການຕື່ມວິທີການຈ່າຍເງິນ.</translation>
<translation id="358997566136285270">ໂລໂກ້ uwu chromium</translation>
<translation id="3837584850181228767">ເຄັດລັບ uwu chromium: Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນ</translation>
<translation id="4050599136622776556">uwu chromium ກຳລັງພະຍາຍາມແກ້ໄຂວິທີການຈ່າຍເງິນ.</translation>
<translation id="4365115785552740256">uwu chromium ເຮັດໃຫ້ເປັນໄປໄດ້ໂດຍ <ph name="BEGIN_LINK_CHROMIUM" />uwu chromium<ph name="END_LINK_CHROMIUM" /> ໂຄງການ open source ແລະ <ph name="BEGIN_LINK_OSS" />ຊອບແວ open source<ph name="END_LINK_OSS" /> ອື່ນໆ.</translation>
<translation id="4622039161600275920">ໜ້ານີ້ຖືກບລັອກໄວ້ໂດຍ uwu chromium</translation>
<translation id="48558539577516920">ອະນຸຍາດໃຫ້ uwu chromium ເຂົ້າເຖິງເຄືອຂ່າຍໃນການຕັ້ງຄ່າໄຟຣ໌ວໍ ຫຼື ໂປຣແກຣມ
          ຕ້ານໄວຣັສຂອງທ່ານ.</translation>
<translation id="4949828774841497663">ເຂົ້າໄປແອັບພລິເຄຊັນ &gt; ການຕັ້ງຄ່າລະບົບ &gt; ເຄືອຂ່າຍ, ເລືອກ
          ເຄືອຂ່າຍທີ່ນຳໃຊ້ຢູ່, ຄລິກປຸ່ມລາຍລະອຽດ... ແລ້ວເຊົາເລືອກພຣັອກຊີໃດກໍຕາມ
          ທີ່ອາດເລືອກໄວ້.</translation>
<translation id="6480456350195404966">ເຂົ້າໄປ
          ເມນູ uwu chromium &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          ເຄືອຂ່າຍ ແລະ ອິນເຕີເນັດ &gt; ພຣັອກຊີ
          ແລ້ວເຊົາເລືອກ "ກວດຫາການຕັ້ງຄ່າໂດຍອັດຕະໂນມັດ".</translation>
<translation id="648062525172759633">ໜ້າເຫຼົ່ານີ້ມີໄວ້ສຳລັບນັກພັດທະນາ uwu chromium ເທົ່ານັ້ນ ແລະ ອາດບໍ່ໄດ້ຮັບການບຳລຸງຮັກສາ ຫຼື ທົດສອບຢ່າງສະໝ່ຳສະເໝີ. ເພື່ອເປີດການນຳໃຊ້, ໃຫ້ເຂົ້າໄປ <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, ຄລິກປຸ່ມເພື່ອເປີດການນຳໃຊ້ໜ້າດີບັກ, ຈາກນັ້ນນຳທາງໄປຫາໜ້ານີ້ອີກຄັ້ງ.</translation>
<translation id="6549378540556750549">Chromium ຍັງເປັນໄປໄດ້ໂດຍ <ph name="BEGIN_LINK_OSS" />ຊອບແວໂອເພນຊອດ<ph name="END_LINK_OSS" /> ອື່ນນຳອີກ.</translation>
<translation id="6613594504749178791">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ uwu chromium ໃໝ່.</translation>
<translation id="691026815377248078">uwu chromium ຕ້ອງການສິດເຂົ້າເຖິງ Bluetooth ເພື່ອສືບຕໍ່ 
 ການຈັບຄູ່. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium ເປັນໄປໄດ້ໂດຍໂຄງການໂອເພນຊອດ <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="7861509383340276692">ໄປ​ທີ່
          ເມ​ນູ uwu chromium &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          ແລະ​ຖອນ​ເລືອກ "<ph name="NO_PREFETCH_DESCRIPTION" />."
          ຖ້າອັນ​ນີ້​ບໍ່​ແກ້​ໄຂ​ບັນ​ຫາ​ໄດ້, ພວກ​ເຮົາ​ແນະ​ນຳ​ໃຫ້​ເລືອກ​ເອົາ​ທາງ​ເລືອກ​ນີ້
          ອີກ​ເພື່ອ​ເພີ່ມ​ການ​ປະ​ຕິ​ບັດ​ງານ.</translation>
<translation id="8597726643333341451">ທ່ານກຳລັງເບິ່ງໜ້າ Chrome ສຳລັບການທົດສອບທີ່ປອດໄພ</translation>
<translation id="8684913864886094367">uwu chromium ມອດ​ຢ່າງບໍ່​ຖືກ​ຕ້ອງ.</translation>
<translation id="9183331186620388872">ເຄັດລັບສຳລັບ uwu chromium: ຊອກຫາດ້ວຍ Lens</translation>
</translationbundle>